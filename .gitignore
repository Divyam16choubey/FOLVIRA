# ── Build outputs ────────────────────────────────────────────────────────────
node_modules/
*/node_modules/
dist/
*/dist/
.vite/
*/.vite/
*.tsbuildinfo
*/*.tsbuildinfo

# ── Environment & Secrets ──────────────────────────────────────────────────
# NEVER commit real environment or secrets files.
.env
.env.*
.env.local
.env.*.local
frontend/.env
frontend/.env.*
frontend/.env.local
backend/.env
backend/.env.*
backend/.env.local

# Whitelist environment documentation templates
!backend/.env.example
!.env.example

# ── Logs & Debugging ───────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Testing & Coverage ─────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ── Runtime & Uploads ──────────────────────────────────────────────────────
uploads/
*/uploads/

# ── OS & Editor Files ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
