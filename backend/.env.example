NODE_ENV=development
PORT=3001

# ── Database (required) ─────────────────────────────────────────────────────
# MongoDB Atlas connection string. Required in all environments.
# Production: must NOT use localhost.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# ── Authentication (required) ───────────────────────────────────────────────
# JWT signing secret. Must be at least 32 characters.
# Production: must be a strong random string (e.g. 64-character hex).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_random_64_character_hex_string
JWT_EXPIRES_IN=7d

# ── Application URLs ────────────────────────────────────────────────────────
# FRONTEND_URL: used for CORS and email links.
# Production: must be the deployed frontend origin (e.g. https://folvira.co).
FRONTEND_URL=http://localhost:5173

# PUBLIC_ORIGIN: the public URL where the app is accessible.
# Used in deployment documentation context. Optional.
# PUBLIC_ORIGIN=https://folvira.co

# ── Email Provider (optional) ───────────────────────────────────────────────
# SMTP configuration for transactional emails (verification, password reset).
# Email features are safely skipped if unconfigured; the server starts without them.
# Production: Configure with your SMTP service (e.g. AWS SES, SendGrid, Postmark, Resend).
# Development: Leave empty to log verification/reset URLs to the console, or use Mailtrap/Ethereal.
EMAIL_FROM=FOLVIRA <noreply@folvira.co>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password

# ── AI Provider (optional) ──────────────────────────────────────────────────
# Supported: openai
# If AI_API_KEY is not set, AI endpoints return a configuration error gracefully.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
