NODE_ENV=development
PORT=3001


MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority


JWT_SECRET=replace_with_a_random_64_character_hex_string
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173


EMAIL_FROM=FOLVIRA <noreply@folvira.co>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# ── AI Provider ──────────────────────────────────────────────────────────────
# Supported: openai
# If AI_API_KEY is not set, AI endpoints return a configuration error gracefully.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
