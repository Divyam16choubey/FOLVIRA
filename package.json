{
  "name": "folvira-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "start:backend": "npm --prefix backend run start",
    "typecheck": "npm --prefix frontend run build && npm --prefix backend run typecheck",
    "test": "npm --prefix backend run test",
    "test:smoke": "npm --prefix backend run test:smoke",
    "test:ai": "npm --prefix backend run test:ai",
    "test:portfolio": "npm --prefix backend run test:portfolio",
    "test:phase6": "npm --prefix backend run test:phase6",
    "test:phase7": "npm --prefix backend run test:phase7",
    "test:phase8": "npm --prefix backend run test:phase8",
    "test:phase9": "npm --prefix backend run test:phase9"
  }
}
